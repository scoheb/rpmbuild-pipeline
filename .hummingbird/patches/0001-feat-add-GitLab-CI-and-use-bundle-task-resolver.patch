From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Robert Sturla <rsturla@redhat.com>
Date: Sat, 28 Feb 2026 13:03:00 +0000
Subject: [PATCH 1/2] feat: add GitLab CI and use bundle task resolver

Add GitLab CI pipeline for building and publishing Tekton task/pipeline
bundles to quay.io/hummingbird-ci/.

Replace upstream's git resolver taskRefs (which use self-ref-url/revision
parameters) with bundles resolver using __TASK_BUNDLE_TAG__ placeholders.
The CI pipeline substitutes these at build time.

Include an upstream:check CI job that runs 'make -C .hummingbird check'
to verify root files stay in sync with .hummingbird/src + patches.

Signed-off-by: patch-regen <patch-regen@localhost>
---
 .gitlab-ci.yml                  | 104 ++++++++++++++++++
 docs/parameters.md              |   2 -
 pipeline/build-rpm-package.yaml | 182 +++++++++++++++-----------------
 3 files changed, 188 insertions(+), 100 deletions(-)
 create mode 100644 .gitlab-ci.yml

diff --git a/.gitlab-ci.yml b/.gitlab-ci.yml
new file mode 100644
index 0000000..60610d5
--- /dev/null
+++ b/.gitlab-ci.yml
@@ -0,0 +1,104 @@
+---
+workflow:
+  rules:
+    - if: $CI_PIPELINE_SOURCE == 'merge_request_event' &&
+          $CI_MERGE_REQUEST_EVENT_TYPE != 'merge_train'
+    - if: $CI_PIPELINE_SOURCE == 'merge_request_event' &&
+          $CI_MERGE_REQUEST_EVENT_TYPE == 'merge_train'
+    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
+
+stages:
+  - check
+  - build
+  - deploy
+
+default:
+  tags: [small-runner]
+  retry:
+    max: 2
+    when:
+      - runner_system_failure
+      - stuck_or_timeout_failure
+      - unknown_failure
+      - api_failure
+      - job_execution_timeout
+
+.rules:
+  mr: &mr
+    if: $CI_PIPELINE_SOURCE == 'merge_request_event' &&
+        $CI_MERGE_REQUEST_EVENT_TYPE != 'merge_train'
+  mr_train: &mr_train
+    if: $CI_PIPELINE_SOURCE == 'merge_request_event' &&
+        $CI_MERGE_REQUEST_EVENT_TYPE == 'merge_train'
+  mr_manual:
+    if: $CI_PIPELINE_SOURCE == 'merge_request_event'
+    when: manual
+    allow_failure: true
+  main: &main
+    if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
+
+upstream:check:
+  image: quay.io/hummingbird-ci/gitlab-ci:latest
+  stage: check
+  before_script:
+    - git submodule update --init
+  script:
+    - make -C .hummingbird check
+  rules:
+    - !reference [.rules, mr]
+    - !reference [.rules, mr_train]
+
+.bundle-push:
+  image: ghcr.io/tektoncd/plumbing/tkn:latest
+  script:
+    - |
+      sed -i "s|:__TASK_BUNDLE_TAG__|:${TASK_BUNDLE_TAG}|g" pipeline/build-rpm-package.yaml
+
+      for file in task/*.yaml; do
+        name="${file##*/}"
+        name="${name%.yaml}"
+        tkn bundle push --remote-username $QUAY_USERNAME --remote-password $QUAY_PASSWORD \
+          ${BUNDLE_EXTRA_ARGS:-} -f "$file" "quay.io/hummingbird-ci/rpmbuild-task-${name}:${TASK_BUNDLE_TAG}"
+      done
+
+      tkn bundle push --remote-username $QUAY_USERNAME --remote-password $QUAY_PASSWORD \
+        ${BUNDLE_EXTRA_ARGS:-} -f pipeline/build-rpm-package.yaml \
+        "quay.io/hummingbird-ci/rpmbuild-pipeline:${PIPELINE_BUNDLE_TAG}"
+
+bundles:validate:
+  image: quay.io/hummingbird-ci/gitlab-ci:latest
+  stage: check
+  script:
+    - |
+      for file in task/*.yaml pipeline/*.yaml; do
+        echo "Validating $file..."
+        yq eval '.' "$file" > /dev/null
+      done
+  rules:
+    - !reference [.rules, mr_train]
+
+bundles:test:
+  extends: .bundle-push
+  stage: build
+  variables:
+    TASK_BUNDLE_TAG: pipeline-${CI_PIPELINE_ID}
+    PIPELINE_BUNDLE_TAG: pipeline-${CI_PIPELINE_ID}
+    BUNDLE_EXTRA_ARGS: "--label quay.expires-after=7d"
+  rules:
+    - !reference [.rules, mr]
+
+bundles:release:
+  extends: .bundle-push
+  stage: deploy
+  variables:
+    TASK_BUNDLE_TAG: git-${CI_COMMIT_SHA}
+    PIPELINE_BUNDLE_TAG: git-${CI_COMMIT_SHA}
+  script:
+    - !reference [.bundle-push, script]
+    - |
+      tkn bundle push --remote-username $QUAY_USERNAME --remote-password $QUAY_PASSWORD \
+        -f pipeline/build-rpm-package.yaml \
+        "quay.io/hummingbird-ci/rpmbuild-pipeline:latest"
+  rules:
+    - !reference [.rules, mr_manual]
+    - !reference [.rules, main]
